<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
<Styles>
<Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Bottom"/><Font ss:FontName="Calibri" ss:Size="11"/></Style>
<Style ss:ID="Title"><Font ss:FontName="Calibri" ss:Size="15" ss:Bold="1" ss:Color="#0B1B3A"/></Style>
<Style ss:ID="Head"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#0B1B3A"/></Style>
<Style ss:ID="Body"><Font ss:FontName="Calibri" ss:Size="11" ss:Color="#33415C"/><Alignment ss:Vertical="Top" ss:WrapText="1"/></Style>
<Style ss:ID="Header"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#0A5EEA" ss:Pattern="Solid"/><Alignment ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0B1B3A"/></Borders></Style>
</Styles>
<Worksheet ss:Name="How to use"><Table ss:DefaultColumnWidth="120">
<Column ss:Width="250"/><Column ss:Width="520"/>
<Row><Cell ss:StyleID="Title"><Data ss:Type="String">Philips PH — surveys the Blitz team fills in</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">Every question on each of the three weekly surveys, and every store each one reaches.</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">THE SHEETS</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Channel coverage</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Store counts per channel, and how many are in scope for each survey.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Stores in scope</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">All 638 stores: code, name, channel, region, and Yes/No per survey.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Stock Count &amp; Pricing Feedback</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Its questions, in the order a rep sees them.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Execution (Image Report)</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Its questions.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Competitor Feedback</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Its questions.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">HOW A SURVEY IS STRUCTURED</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Visit header</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Asked once when the rep checks in: rep name, channel, store code, store name, region.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Line rows</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Repeat as many times as needed — one per SKU, per execution shot, per competitor SKU. The rep taps "+ Add another" for each.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Required</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Yes means check-out is refused until it is answered.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">TO CHANGE A SURVEY</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">1</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Write what you want in the "Change / add (write here)" column, or add a row at the bottom for a new question.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">2</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">For a new question give the answer type: text, number, boolean (Yes/No), choice (list the options), or photo.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">3</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">To narrow which stores a survey reaches, change the Yes/No columns on "Stores in scope".</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">4</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Send the workbook back and it gets turned into the survey definition and pushed to Leegra Pulse.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Note</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Surveys are not loaded from Excel directly — the questionnaire loader takes a definition file. This workbook is how you specify the change; Leegra does the push.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Currently excluded</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Dis-Chem (all spellings)</Data></Cell></Row>
</Table></Worksheet>
