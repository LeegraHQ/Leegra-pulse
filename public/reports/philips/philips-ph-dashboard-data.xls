<Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/>
<Row><Cell ss:StyleID="Header"><Data ss:Type="String">Name</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Date</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Check In</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Check Out</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Time Spent</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Channel</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Banner</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Store</Data></Cell></Row>

</Table>
<WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions>
</Worksheet>
<Worksheet ss:Name="Blitz Call Diary"><Table ss:DefaultColumnWidth="115">
<Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/>
<Row><Cell ss:StyleID="Header"><Data ss:Type="String">Rep</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Planned Calls</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Completed Calls</Data></Cell></Row>

</Table>
<WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions>
</Worksheet>
