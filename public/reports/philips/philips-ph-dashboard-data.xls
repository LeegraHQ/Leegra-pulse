<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
<Styles>
<Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Bottom"/><Font ss:FontName="Calibri" ss:Size="11"/></Style>
<Style ss:ID="Title"><Font ss:FontName="Calibri" ss:Size="15" ss:Bold="1" ss:Color="#0B1B3A"/></Style>
<Style ss:ID="Head"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#0B1B3A"/></Style>
<Style ss:ID="Body"><Font ss:FontName="Calibri" ss:Size="11" ss:Color="#33415C"/><Alignment ss:Vertical="Top" ss:WrapText="1"/></Style>
<Style ss:ID="Header"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#0A5EEA" ss:Pattern="Solid"/><Alignment ss:Vertical="Center" ss:WrapText="1"/><Borders><Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0B1B3A"/></Borders></Style>
</Styles>
<Worksheet ss:Name="How to use"><Table ss:DefaultColumnWidth="120">
<Column ss:Width="230"/><Column ss:Width="470"/>
<Row><Cell ss:StyleID="Title"><Data ss:Type="String">Philips PH — Blitz Dashboard data workbook</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">One sheet per section of the dashboard at leegra-pulse.netlify.app/reports/philips/.</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">Each sheet is named after its section, columns in that section’s exact order.</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">Do not rename the sheets, and do not add, remove or reorder columns.</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">WHAT IS ALREADY FILLED IN</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Competitor Feedback</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">72 lines transcribed from the "What’s happening in field" deck (6 leaflet photos).</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Blitz, Store Code, Store Name and Region are BLANK — the photos do not carry them. Fill those before importing.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Competitor On-shelf Price is the price a shopper pays today (Clicks promo / Dis-Chem member price), so On Promo reads Yes throughout.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">The regular shelf price sits on the "Competitor Feedback (source)" sheet next to each line, with the saving.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">That source sheet is reference only — it is never imported.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">All other sheets</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Headings only, ready to fill.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">HOW TO UPDATE THE DASHBOARD</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">1</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Fill rows under the headings on the sheet you want to update. Keep the heading row.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">2</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Save the workbook (.xls or .xlsx — either is fine).</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">3</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Open the dashboard with the unlock link, once per device: /reports/philips/?unlock=leegraph2026</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">4</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Click that section in the left sidebar, then "Import from Excel" and pick this file.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">5</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Enter your admin code when prompted (once per browser session).</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">The upload reads the sheet matching the section you clicked, so one workbook covers them all.</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">WHAT HAPPENS TO EXISTING DATA</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Nothing is overwritten</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Each upload is stored as its own batch and appends. April, then May, then June add up.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Live app data stays</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Rep check-ins and survey answers keep flowing in and sit alongside these rows.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Do not import twice</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Importing the same sheet again adds the rows a second time.</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">FORMATS</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Date</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">2026-04-15 (or 15/04/2026 — both read correctly)</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Check In / Check Out</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">07:45 — 24-hour time</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Time Spent</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Minutes as a plain number, e.g. 42</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Month</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">April 2026</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Money</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Plain numbers, no R and no thousands separator: 1299.99</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">On Promo / Listing</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Yes or No</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Images</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">A URL, or leave blank — photos captured in the app come through on their own</Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Head"><Data ss:Type="String">NOT IN THIS WORKBOOK</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String"></Data></Cell></Row>
<Row><Cell ss:StyleID="Body"><Data ss:Type="String">Blitz Performance</Data></Cell><Cell ss:StyleID="Body"><Data ss:Type="String">Calculated by the dashboard from Time &amp; Attendance and the call diary.</Data></Cell></Row>
</Table></Worksheet>
<Worksheet ss:Name="Weekly Feedback Report"><Table ss:DefaultColumnWidth="115">
<Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/><Column ss:Width="130"/>
<Row><Cell ss:StyleID="Header"><Data ss:Type="String">Survey</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Supplier</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Region</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Staff</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Category</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Store</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Question</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Response</Data></Cell><Cell ss:StyleID="Header"><Data ss:Type="String">Date</Data></Cell></Row>

</Table>
<WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel"><FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane></WorksheetOptions>
</Worksheet>
