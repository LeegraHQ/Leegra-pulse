<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet">
<Styles>
 <Style ss:ID="Default" ss:Name="Normal"><Alignment ss:Vertical="Bottom"/><Font ss:FontName="Calibri" ss:Size="11"/></Style>
 <Style ss:ID="hdr"><Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#111827" ss:Pattern="Solid"/></Style>
</Styles>
<Worksheet ss:Name="Instructions"><Table><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Row ss:StyleID="hdr"><Cell><Data ss:Type="String">Sheet</Data></Cell><Cell><Data ss:Type="String">How to fill it</Data></Cell></Row><Row><Cell><Data ss:Type="String">Store Report</Data></Cell><Cell><Data ss:Type="String">One row per mystery shopper visit. Keep headers exactly as they are — the dashboard reads them by name.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Executive Summary</Data></Cell><Cell><Data ss:Type="String">One row per month. Paste the written summary for that month; it appears under the Month filter on the dashboard.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Warranty Guarantees Promos</Data></Cell><Cell><Data ss:Type="String">One row per item mentioned. Type must be Warranty, Guarantee or Promotion. Month and Channel drive the two filters.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Brand Visibility POSM</Data></Cell><Cell><Data ss:Type="String">One row per dealer group per month. Month drives the filter; leave a cell blank where nothing was measured.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Monthly Trends</Data></Cell><Cell><Data ss:Type="String">The headline percentages per month — fills the line charts and KPI tiles.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Demographics</Data></Cell><Cell><Data ss:Type="String">Shopper age group and vehicle type shares per month.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Competition Execution</Data></Cell><Cell><Data ss:Type="String">POSM cube and counter-flyer visibility per channel per month.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Pricing</Data></Cell><Cell><Data ss:Type="String">One row per price quoted in store. Placeholder structure — replace with your own pricing template when you send it.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Stores</Data></Cell><Cell><Data ss:Type="String">Master store list per region, used to load stores into Leegra Pulse for live check-ins.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Photos</Data></Cell><Cell><Data ss:Type="String">One row per photo. Category decides which picture tab it lands under; filename must match the file uploaded to Supabase.</Data></Cell></Row><Row><Cell/><Cell/></Row><Row><Cell><Data ss:Type="String">Dates as YYYY-MM-DD. Yes/No columns as the words Yes or No. Leave blank rather than writing N/A.</Data></Cell><Cell/></Row><Row><Cell><Data ss:Type="String">Name photo files with the store code first, e.g. BD-PE-001_posm.jpg, so they match automatically.</Data></Cell><Cell/></Row></Table></Worksheet>
<Worksheet ss:Name="Store Report"><Table><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Column ss:AutoFitWidth="0" ss:Width="140"/><Row ss:StyleID="hdr"><Cell><Data ss:Type="String">Visit ID</Data></Cell><Cell><Data ss:Type="String">Visit Date (YYYY-MM-DD)</Data></Cell><Cell><Data ss:Type="String">Month</Data></Cell><Cell><Data ss:Type="String">Store Name</Data></Cell><Cell><Data ss:Type="String">Store Code</Data></Cell><Cell><Data ss:Type="String">Dealer Group / Channel</Data></Cell><Cell><Data ss:Type="String">Region</Data></Cell><Cell><Data ss:Type="String">Province</Data></Cell><Cell><Data ss:Type="String">Shopper Name</Data></Cell><Cell><Data ss:Type="String">Shopper Age Group</Data></Cell><Cell><Data ss:Type="String">Vehicle Type</Data></Cell><Cell><Data ss:Type="String">Brand Recommended</Data></Cell><Cell><Data ss:Type="String">Recommendation Basis (Price/Quality)</Data></Cell><Cell><Data ss:Type="String">Bridgestone Stock Available (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Firestone Stock Available (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Bridgestone Fixed Signage (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Firestone Fixed Signage (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Bridgestone POSM Available (Yes/No)</Data></Cell><Cell><Data ss:Type="String">POSM Cube Visible (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Counter Flyer Visible (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Warranty Offered (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Warranty Type</Data></Cell><Cell><Data ss:Type="String">Guarantee Offered (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Guarantee Type</Data></Cell><Cell><Data ss:Type="String">Promotion Mentioned (Yes/No)</Data></Cell><Cell><Data ss:Type="String">Promotion Name</Data></Cell><Cell><Data ss:Type="String">Sample Quote (staff words)</Data></Cell><Cell><Data ss:Type="String">Photo: POSM Display (filename)</Data></Cell><Cell><Data ss:Type="String">Photo: Warranty Display (filename)</Data></Cell><Cell><Data ss:Type="String">Photo: Guarantee Display (filename)</Data></Cell><Cell><Data ss:Type="String">Photo: General (filename)</Data></Cell><Cell><Data ss:Type="String">Photo: Sample Quote (filename)</Data></Cell><Cell><Data ss:Type="String">Notes</Data></Cell></Row><Row><Cell><Data ss:Type="String">BRG-V0001</Data></Cell><Cell><Data ss:Type="String">2026-06-04</Data></Cell><Cell><Data ss:Type="String">June 2026</Data></Cell><Cell><Data ss:Type="String">Best Drive PE</Data></Cell><Cell><Data ss:Type="String">BD-PE-001</Data></Cell><Cell><Data ss:Type="String">Best Drive</Data></Cell><Cell><Data ss:Type="String">EC</Data></Cell><Cell><Data ss:Type="String">Eastern Cape</Data></Cell><Cell><Data ss:Type="String">Shopper 1</Data></Cell><Cell><Data ss:Type="String">30-40 years</Data></Cell><Cell><Data ss:Type="String">4x4 / SUV / Crossover</Data></Cell><Cell><Data ss:Type="String">Dunlop</Data></Cell><Cell><Data ss:Type="String">Price</Data></Cell><Cell><Data ss:Type="String">Yes</Data></Cell><Cell><Data ss:Type="String">No</Data></Cell><Cell><Data ss:Type="String">No</Data></Cell><Cell><Data ss:Type="String">No</Data></Cell><Cell><Data ss:Type="String">No</Data></Cell><Cell><Data ss:Type="String">No</Data></Cell><Cell><Data ss:Type="String">No</Data></Cell><Cell><Data ss:Type="String">Yes</Data></Cell><Cell><Data ss:Type="String">Bridgestone Firestone 1 Year</Data></Cell><Cell><Data ss:Type="String">No</Data></Cell><Cell/><Cell><Data ss:Type="String">Yes</Data></Cell><Cell><Data ss:Type="String">Supa Quick 40th Birthday Bash</Data></Cell><Cell><Data ss:Type="String">Dunlop gives you better value at this price</Data></Cell><Cell><Data ss:Type="String">BD-PE-001_posm.jpg</Data></Cell><Cell><Data ss:Type="String">BD-PE-001_warranty.jpg</Data></Cell><Cell><Data ss:Type="String">BD-PE-001_guarantee.jpg</Data></Cell><Cell><Data ss:Type="String">BD-PE-001_general.jpg</Data></Cell><Cell><Data ss:Type="String">BD-PE-001_quote.jpg</Data></Cell><Cell><Data ss:Type="String">Example row — delete before sending back</Data></Cell></Row></Table></Worksheet>
